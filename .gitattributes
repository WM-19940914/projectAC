# Normalize text files to LF by default.
* text=auto eol=lf

# Keep Windows command scripts on CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common assets and documents as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.xlsx binary
*.xls binary
*.pdf binary
